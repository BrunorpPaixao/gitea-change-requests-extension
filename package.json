{
  "name": "gitea-pr-review-exporter",
  "version": "1.1.4",
  "private": true,
  "description": "Chrome extension to export unresolved Gitea PR review conversations as JSON.",
  "type": "module",
  "scripts": {
    "lint": "node scripts/ci/lint.mjs",
    "test": "node scripts/ci/test.mjs && node --test tests/*.test.mjs",
    "package-check": "node scripts/ci/package-check.mjs",
    "release:package": "node scripts/release/package.mjs",
    "ci": "npm run lint && npm run test && npm run package-check",
    "skill:package": "python3 scripts/release/artifacts.py skill",
    "release:prepare": "node scripts/release/release.mjs prepare",
    "release:finalize": "node scripts/release/release.mjs finalize",
    "release:bundle": "node scripts/release/release.mjs bundle",
    "release:publish": "node scripts/release/release.mjs publish"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "jsdom": "^24.1.0"
  }
}
