{
  "manifest_version": 3,
  "name": "Gitea PR Review Exporter",
  "version": "1.1.1",
  "description": "Export Gitea pull request review conversation nodes (Change requests, Comments) as JSON.",
  "homepage_url": "https://github.com/BrunorpPaixao/gitea-change-requests-extension",
  "permissions": ["activeTab", "tabs", "downloads", "clipboardWrite", "storage", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Gitea PR Review Exporter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
